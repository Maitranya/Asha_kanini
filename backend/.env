# PostgreSQL connection string, e.g. from Render/Railway/Supabase
DATABASE_URL=postgresql://neondb_owner:npg_xZ6B0TdnRUSG@ep-late-base-axtdu2ma.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require

# Set to "false" only for local Postgres without SSL
